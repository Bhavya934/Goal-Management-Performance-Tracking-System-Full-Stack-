# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection (Supabase / Neon / Vercel Postgres)
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Auth.js ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"

# ─── Next.js ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# In production on Vercel, NEXTAUTH_URL is automatically set
